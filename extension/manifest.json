{
  "manifest_version": 3,
  "name": "C2C Local Codex Handoff",
  "version": "0.2.0",
  "description": "Explicitly send a strict C2C task block to the local Codex bridge with one-click pairing.",
  "host_permissions": ["http://127.0.0.1:62141/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "C2C Local Codex Handoff",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
